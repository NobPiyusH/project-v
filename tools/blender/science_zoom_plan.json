  "time_scale_days_per_s": [[0, 1], [6.5, 1], [9.0, 30.4], [13.5, 30.4], [15.5, 365.25], [20.0, 365.25], [23.5, 3.65e9], [30, 3.65e9]],

  "labels": {
    "titles": [
      {"text": "THE MOON AROUND THE EARTH", "from": 0.4, "to": 7.2},
      {"text": "THE EARTH AROUND THE SUN", "from": 7.2, "to": 20.0},
      {"text": "THE SUN AROUND THE MILKY WAY", "from": 20.0, "to": 31.0}
    ],
    "rates": [
      {"text": "1 SECOND = 1 DAY", "from": 0.2, "to": 6.6},
      {"text": "1 SECOND = 1 MONTH", "from": 6.6, "to": 15.5},
      {"text": "1 SECOND = 1 YEAR", "from": 15.5, "to": 22.8},
      {"text": "1 SECOND = 10 MILLION YEARS", "from": 22.8, "to": 31.0}
    ],
    "note": "NOT TO SCALE"

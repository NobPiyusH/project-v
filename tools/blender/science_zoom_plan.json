  "zoom": [
    [0.0, 1.5], [3.5, 3.2], [6.5, 10.0], [7.8, 70.0], [9.0, 300.0], [10.2, 520.0], [12.5, 750.0],
    [17.0, 3000.0], [20.0, 9000.0], [23.5, 24000.0], [27.0, 37500.0], [30.0, 41000.0]
  ],
  "note_zoom": "[time_s, half-width of the frame in A units] - interpolated monotone-cubic in log space, so the pull-back never stops or jerks",

  "focus": [[0, "earth"], [7.5, "earth"], [10.8, "sun"], [19.0, "sun"], [25.0, "galaxy"], [30, "galaxy"]],
  "elevation_deg": [[0, 14], [7, 24], [15, 34], [25, 52], [30, 58]],

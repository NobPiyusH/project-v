  "view_halfwidth": 1.5,

  "levels": {"A": 1.0, "B": 30.0, "C": 840.0},
  "note_levels": "unit of each layer in Earth-radius units (A). Earth-Moon layer: Earth radius 1. Sun-Earth layer: 1 B = 30 A. Galaxy layer: 1 C = 840 A. Every size is deliberately compressed (not to scale).",

  "bodies": {
    "earth_radius": 1.0,
    "moon_radius": 0.45, "moon_orbit": 7.0, "moon_period_days": 27.32, "moon_incl_deg": 5.1,
    "sun_radius_B": 2.2,
    "planets": [
      {"name": "mercury", "orbit_B": 5.2,  "period_days": 87.97,  "color": [0.55, 0.52, 0.50], "phase_deg": 200},
      {"name": "venus",   "orbit_B": 8.6,  "period_days": 224.7,  "color": [0.95, 0.80, 0.55], "phase_deg": 80},
      {"name": "earth",   "orbit_B": 14.0, "period_days": 365.25, "phase_deg": 40},
      {"name": "mars",    "orbit_B": 20.0, "period_days": 686.98, "color": [0.80, 0.38, 0.22], "phase_deg": 300}

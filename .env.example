# Copy this file to .env and fill in the values. .env is git-ignored. Never commit or share real keys.

# --- LLM (Planner and, later, the agents) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: uncomment to override the default Gemini model
# GEMINI_MODEL=

# --- Local services (defaults match infra/docker-compose.yml) ---
POSTGRES_URL=jdbc:postgresql://localhost:5433/projectv
POSTGRES_USER=projectv
POSTGRES_PASSWORD=projectv-local
TEMPORAL_TARGET=localhost:7233
TEMPORAL_NAMESPACE=default

# S3-compatible object store (SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=projectv
S3_SECRET_KEY=projectv-local-secret

# Optional overrides for media models (defaults in control-plane application.properties)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_MUSIC_MODEL=lyria-3.5
# GEMINI_TTS_VOICE=Charon
# NVIDIA API catalog (build.nvidia.com), OpenAI-compatible
NVIDIA_API_KEY=
# Groq (console.groq.com), free tier, OpenAI-compatible
GROQ_API_KEY=
# OpenRouter (openrouter.ai), OpenAI-compatible
OPENROUTER_API_KEY=
# Anthropic Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# ElevenLabs voice (optional)
ELEVENLABS_API_KEY=

# Freesound sound effects (free key: freesound.org -> API -> Apply for credentials)
FREESOUND_API_KEY=

# Gemini multi-project failover (optional): alias:project-id:priority, lower priority first
# GEMINI_PROJECTS=main:gen-lang-client-xxxx:1,second:your-project-id:2
# GEMINI_KEY_MAIN=
# GEMINI_KEY_SECOND=

# Video clips: Wan drafts + Gemini Omni 720p finals (~Rs 46 per 5 s final incl. calibration)
VIDEO_PROVIDER_DRAFT=wan
VIDEO_PROVIDER_FINAL=omni
OMNI_MODEL=gemini-omni-1.2-flash

# 0 = narration uses Gemini voices cast per story (default); 1 = Chatterbox (free, local) first
PROJECTV_CHATTERBOX=0

# Pixabay API key (free; images and videos only, no music via the API)
PIXABAY_API_KEY=
# Dream Shorts: the owner's own track used as every Short's music by default (storage address, e.g. s3://projectv/music-beds/track.m4a)
DREAM_MUSIC_BED=
# Dream Shorts Scout: YouTube Data API v3 key (free quota) to find similar Shorts; without it the Scout uses Google Search
YOUTUBE_API_KEY=

# AICredits.in (INR wallet): errors-only text fallback when Gemini/Claude return 5xx, 429 or time out. Never used for caps.
# Off by default; set the key and AICREDITS_FALLBACK_ENABLED=true to turn it on. Total spend capped in config/providers.yaml.
AICREDITS_API_KEY=
AICREDITS_FALLBACK_ENABLED=false

# RunPod (GPU pods). The watchdog is live (terminates studio-prefixed pods past their limits); GPU_WATCHDOG_DRY_RUN=false only logs. Limits: see application.properties (GPU_*).
RUNPOD_API_KEY=
# Vast.ai (GPU rental from other people's machines). The key needs instance read + write rights. It never leaves this machine: nothing is sent to an instance.
VAST_API_KEY=
# Optional: secret for the per-rental worker tokens (default: derived from the provider keys above). POD_TOKEN_RUNPOD=false turns tokens off for RunPod pods only.
POD_TOKEN_SECRET=
POD_TOKEN_RUNPOD=true
# modal (default) or broker: where Dream Shorts get GPUs. Per-provider caps live in config/providers.yaml (pricing.gpuBroker), all 0.
DREAM_GPU_PROVIDER=modal
# Pod picture model for Dream Shorts: flux2-klein (default) or zimage
DREAM_PICTURE_MODEL=flux2-klein
GPU_WATCHDOG_DRY_RUN=false

GRIDSHARE_API_KEY=
JARVISLABS_API_KEY=
SALAD_API_KEY=
SALAD_AI_GATEWAY_KEY=
# Vast.ai (GPU marketplace; the broker adapter is not built yet)
VAST_API_KEY=
